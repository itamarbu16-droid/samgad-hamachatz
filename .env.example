# Local synthetic development. Never commit real credentials.
DEMO_MODE=true
PGLITE_DATA_DIR=.data/postgres
DEMO_EMAIL=demo@samgad.example
DEMO_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Required on Vercel: use a managed PostgreSQL connection string.
# DATABASE_URL=
# Optional task notification service: verified sender + server-only Resend key.
# RESEND_API_KEY=
# MAIL_FROM=
# CRON_SECRET=

# Optional per-user Google Calendar OAuth connection (never commit real secrets).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional hourly reminder backend; no schedule is configured.
HOURLY_REMINDERS_ENABLED=false
# Provision separately before activation: 32 random bytes, canonical base64url.
# Must differ from CRON_SECRET. Never commit an actual value.
# HOURLY_REMINDERS_SECRET=
